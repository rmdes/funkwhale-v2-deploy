# Funkwhale configuration - managed by Ansible

FUNKWHALE_HOSTNAME={{ funkwhale_hostname }}
FUNKWHALE_PROTOCOL={{ funkwhale_protocol }}
DJANGO_SECRET_KEY={{ funkwhale_django_secret_key }}

FUNKWHALE_API_IP={{ funkwhale_api_ip }}
FUNKWHALE_API_PORT={{ funkwhale_api_port }}
FUNKWHALE_WEB_WORKERS={{ funkwhale_web_workers }}
REVERSE_PROXY_TYPE=nginx

DATABASE_URL=postgresql://{{ funkwhale_db_user }}@:5432/{{ funkwhale_db_name }}
CACHE_URL=redis://127.0.0.1:6379/0

MEDIA_ROOT={{ funkwhale_data_dir }}/media
STATIC_ROOT={{ funkwhale_data_dir }}/static
MUSIC_DIRECTORY_PATH={{ funkwhale_data_dir }}/music
MUSIC_DIRECTORY_SERVE_PATH={{ funkwhale_data_dir }}/music
FUNKWHALE_FRONTEND_PATH={{ funkwhale_dir }}/front/dist
FUNKWHALE_SPA_HTML_ROOT={{ funkwhale_dir }}/front/dist/index.html
NGINX_MAX_BODY_SIZE={{ nginx_max_body_size }}
DJANGO_SETTINGS_MODULE=config.settings.production
CELERYD_CONCURRENCY={{ celery_concurrency }}
