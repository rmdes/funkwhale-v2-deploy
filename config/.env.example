# Funkwhale v2 environment configuration
# Copy this file to /srv/funkwhale/config/.env and edit the values

# Replace with your actual domain
FUNKWHALE_HOSTNAME=your-domain.example.com
FUNKWHALE_PROTOCOL=https

# IMPORTANT: Generate a unique secret key before first run:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key

FUNKWHALE_API_IP=127.0.0.1
FUNKWHALE_API_PORT=5000
FUNKWHALE_WEB_WORKERS=4
REVERSE_PROXY_TYPE=nginx

DATABASE_URL=postgresql://funkwhale@:5432/funkwhale
CACHE_URL=redis://127.0.0.1:6379/0

MEDIA_ROOT=/srv/funkwhale/data/media
STATIC_ROOT=/srv/funkwhale/data/static
MUSIC_DIRECTORY_PATH=/srv/funkwhale/data/music
MUSIC_DIRECTORY_SERVE_PATH=/srv/funkwhale/data/music
FUNKWHALE_FRONTEND_PATH=/srv/funkwhale/front/dist
FUNKWHALE_SPA_HTML_ROOT=/srv/funkwhale/front/dist/index.html
NGINX_MAX_BODY_SIZE=2000M
DJANGO_SETTINGS_MODULE=config.settings.production
CELERYD_CONCURRENCY=0

# Set to True to enable the browsable API interface
BROWSABLE_API_ENABLED=False

# Set to True for debugging (disable in production)
DEBUG=false
